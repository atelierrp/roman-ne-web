---
/**
 * @typedef {{ title: string; description?: string }} Props
 * @type {Props}
 */
const {
  title,
  description = "Roman Ne — sound, attention, spatial situations.",
  noindex = false,
  ogTitle = "Roman Ne",
  ogDescription = "sound silence attention",
} = Astro.props;
const canonicalHref =
  !noindex && Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : undefined;
const defaultOgImage = "/images/og.jpg";
const ogImageUrl = Astro.site
  ? new URL(defaultOgImage, Astro.site).href
  : new URL(defaultOgImage, Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style is:inline>
      html:not(.fonts-ready) .page-frame {
        opacity: 0;
      }
      html.fonts-ready .page-frame {
        opacity: 1;
      }
      @media (scripting: none) {
        .page-frame {
          opacity: 1 !important;
        }
      }
    </style>
    <link
      rel="preload"
      href="/greed/GreedStandard-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/greed/GreedExtended-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {!noindex && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <slot name="head" />
  </head>
  <body>
    <div class="page-frame">
      <slot />
    </div>
    <script is:inline>
      (function () {
        function revealFonts() {
          document.documentElement.classList.add("fonts-ready");
        }
        function loadFonts() {
          if (!document.fonts || !document.fonts.load) {
            revealFonts();
            return;
          }
          if (document.documentElement.classList.contains("fonts-ready")) {
            return;
          }
          var t = setTimeout(revealFonts, 3000);
          Promise.all([
            document.fonts.load('400 23px "Greed Regular"'),
            document.fonts.load('400 19px "Greed Regular"'),
            document.fonts.load('800 64px "Greed Wide Bold"'),
            document.fonts.load('800 25px "Greed Wide Bold"'),
          ])
            .catch(function () {})
            .then(function () {
              clearTimeout(t);
              revealFonts();
            });
        }
        loadFonts();
      })();
    </script>
    <script is:inline>
      (function () {
        var thresholdPx = 20;
        function syncNavScroll() {
          var concealed = window.scrollY > thresholdPx;
          document.documentElement.toggleAttribute(
            "data-nav-scroll-concealed",
            concealed,
          );
        }
        syncNavScroll();
        window.addEventListener("scroll", syncNavScroll, { passive: true });
      })();
    </script>
  </body>
</html>
