---
/**
 * Same bar on every width: Roman Ne, then Ongoing, Bio, Contact.
 * Narrow screens push Ongoing, Bio, and Contact to the right.
 * The Ongoing list opens under that item.
 * `activeId`: home | hcyn | adjustments | listening | bio | contact
 */
const ENABLE_ONGOING_NAV = true;

const { activeId = "" } = Astro.props;

const homeLink = { id: "home", href: "/", label: "Roman Ne" };
const ongoingLinks = [
  { id: "hcyn", href: "/hardcoreyoganidra", label: "Hardcore Yoga Nidra" },
  {
    id: "listening",
    href: "/temporary-listening-spaces",
    label: "Temporary Listening Spaces",
  },
  {
    id: "adjustments",
    href: "/adjustmentstonothing",
    label: "Adjustments to Nothing",
  },
];
const pageLinks = [
  { id: "bio", href: "/bio", label: "Bio" },
  { id: "contact", href: "/contact", label: "Contact" },
];
const ongoingCurrent = ongoingLinks.some((l) => l.id === activeId);
---

<div class="site-nav-slot">
  <nav class="site-nav site-nav--bar" aria-label="Primary">
    <ul class="site-nav__list site-nav__list--brand">
      <li>
        <a
          href={homeLink.href}
          aria-current={activeId === homeLink.id ? "page" : undefined}
        >
          {homeLink.label}
        </a>
      </li>
    </ul>
    <ul class="site-nav__list site-nav__list--pages">
      {
        ENABLE_ONGOING_NAV && (
          <li
            class:list={[
              "site-nav__item",
              "site-nav__item--has-sub",
              ongoingCurrent && "is-current",
            ]}
          >
            <button
              type="button"
              class="site-nav__trigger"
              aria-expanded="false"
              aria-controls="site-nav-ongoing"
              aria-current={ongoingCurrent ? "true" : undefined}
            >
              Ongoing
            </button>
            <ul id="site-nav-ongoing" class="site-nav__sublist">
              {ongoingLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={activeId === l.id ? "page" : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        )
      }
      {
        pageLinks.map((l) => (
          <li class="site-nav__item">
            <a
              href={l.href}
              aria-current={activeId === l.id ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

{
  ENABLE_ONGOING_NAV && (
    <script is:inline>
      (function () {
        var item = document.querySelector(".site-nav__item--has-sub");
        if (!item) return;
        var trigger = item.querySelector(".site-nav__trigger");
        if (!trigger) return;

        var phone = window.matchMedia("(max-width: 767px)");

        function setOpen(open) {
          item.classList.toggle("is-open", open);
          trigger.setAttribute("aria-expanded", open ? "true" : "false");
          document.documentElement.classList.toggle(
            "nav-sub-open",
            open && phone.matches,
          );
        }

        trigger.addEventListener("click", function (event) {
          event.preventDefault();
          event.stopPropagation();
          setOpen(!item.classList.contains("is-open"));
        });

        document.addEventListener("click", function (event) {
          if (!item.classList.contains("is-open")) return;
          if (event.target.closest(".site-nav__sublist a")) return;
          if (event.target.closest(".site-nav__trigger")) return;
          setOpen(false);
        });

        document.addEventListener(
          "touchmove",
          function (event) {
            if (!document.documentElement.classList.contains("nav-sub-open")) {
              return;
            }
            if (event.target.closest(".site-nav__sublist a")) return;
            event.preventDefault();
          },
          { passive: false },
        );

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") setOpen(false);
        });
      })();
    </script>
  )
}
