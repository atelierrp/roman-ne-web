---
/**
 * Primary bar nav.
 * Set `ENABLE_ONGOING_NAV` to true to show Ongoing (sub: projects) instead of Roman Ne.
 * `activeId`: home | hcyn | adjustments | bio | contact
 */
const ENABLE_ONGOING_NAV = false;

const { activeId = "" } = Astro.props;

const homeLink = { id: "home", href: "/", label: "Roman Ne" };
const ongoingLinks = [
  { id: "hcyn", href: "/hardcoreyoganidra", label: "Hardcore Yoga Nidra" },
  {
    id: "adjustments",
    href: "/adjustmentstonothing",
    label: "Adjustments to Nothing",
  },
];
const pageLinks = [
  { id: "bio", href: "/bio", label: "Bio" },
  { id: "contact", href: "/contact", label: "Contact" },
];
const ongoingCurrent = ongoingLinks.some((l) => l.id === activeId);
---

<div class="site-nav-slot">
  <nav class="site-nav site-nav--bar" aria-label="Primary">
    {
      !ENABLE_ONGOING_NAV && (
        <ul class="site-nav__list site-nav__list--brand">
          <li>
            <a
              href={homeLink.href}
              aria-current={activeId === homeLink.id ? "page" : undefined}
            >
              {homeLink.label}
            </a>
          </li>
        </ul>
      )
    }
    <ul class="site-nav__list site-nav__list--pages">
      {
        ENABLE_ONGOING_NAV && (
          <li
            class:list={[
              "site-nav__item",
              "site-nav__item--has-sub",
              ongoingCurrent && "is-current",
            ]}
            data-nav-sub
          >
            <button
              type="button"
              class="site-nav__trigger"
              aria-expanded="false"
              aria-controls="site-nav-ongoing"
              aria-current={ongoingCurrent ? "true" : undefined}
            >
              Ongoing
            </button>
            <ul id="site-nav-ongoing" class="site-nav__sublist">
              {ongoingLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={activeId === l.id ? "page" : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        )
      }
      {
        pageLinks.map((l) => (
          <li class="site-nav__item">
            <a
              href={l.href}
              aria-current={activeId === l.id ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

{
  ENABLE_ONGOING_NAV && (
    <script is:inline>
      (function () {
        var roots = document.querySelectorAll("[data-nav-sub]");
        if (!roots.length) return;

        function setOpen(item, open) {
          var trigger = item.querySelector(".site-nav__trigger");
          item.classList.toggle("is-open", open);
          if (trigger)
            trigger.setAttribute("aria-expanded", open ? "true" : "false");
        }

        roots.forEach(function (item) {
          var trigger = item.querySelector(".site-nav__trigger");
          if (!trigger) return;

          trigger.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();
            setOpen(item, !item.classList.contains("is-open"));
          });

          item.addEventListener("keydown", function (event) {
            if (event.key === "Escape") setOpen(item, false);
          });
        });

        document.addEventListener("click", function (event) {
          roots.forEach(function (item) {
            if (!item.contains(event.target)) setOpen(item, false);
          });
        });
      })();
    </script>
  )
}
