---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Roman Ne — Listening Spaces"
  description="Ongoing artistic research into listening spaces, 2026–2027."
>
  <main class="site-main">
    <SiteNav activeId="listening" />
    <div class="site-content" id="site-content">
      <article class="bio-layout cas-doc">
        <div class="bio-layout__column">
          <header class="cas-doc__header">
            <h1>Listening Spaces</h1>
          </header>
          <div class="cas-doc__body">
            <p>
              Ongoing artistic research, 2026–2027<br />
              Developed within the CAS Arts and International Cooperation programme
              at Zurich University of the Arts (ZHdK).
            </p>
            <p></p>
            <p>
              The research investigates listening environments that people can
              enter, inhabit and leave freely. Through sound and a minimal
              sequence of spoken words, listeners’ attention is guided between
              the body, the surrounding space and listening itself.
            </p>
            <p>
              It asks whether such environments could offer a temporary sense of
              ease in contexts affected by displacement, uncertainty or prolonged
              instability.
            </p>
            <p>
              A point of departure was a series of listening sessions held in
              Yerevan, attended by people displaced from Nagorno-Karabakh
              alongside other participants. These experiences raised questions
              about how the work might be developed responsibly in contexts
              shaped by displacement.
            </p>
            <p>
              The research is currently focused on consultations and contextual
              research in Northern Thailand.
            </p>
          </div>
        </div>
        <aside class="bio-layout__aside">
          <figure class="cas-doc__figure">
            <img
              class="cas-doc__img"
              src="/images/yerevan.jpg"
              alt="A figure seen through frosted glass in a listening space"
              width="1500"
              height="2000"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="cas-doc__caption">
              HCYN listening space, artasfoundation (Living Room)<br />
              Yerevan, Armenia 2026
            </figcaption>
          </figure>
        </aside>
      </article>
    </div>
  </main>
</BaseLayout>
