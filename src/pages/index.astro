---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Roman Ne"
  description="Roman Ne — sound, attention, spatial situations."
>
  <main class="site-main site-main--home">
    <SiteNav activeId="home" />
    <div class="home-splash" id="site-content">
      <img
        class="home-splash__img"
        src="/images/roman-ne-hcyn.jpg"
        alt="Roman Ne"
        width="1500"
        height="2000"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </main>
</BaseLayout>
